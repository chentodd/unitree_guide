{
    "name": "ROS 1 Development Container",
    "privileged": true,
    "remoteUser": "todd",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "todd"
        }
    },
    "workspaceFolder": "/home/todd/ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/todd/ws,type=bind",
    "customizations": {
        "vscode": {
            "extensions":[
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "eamodio.gitlens"
            ]
        }
    },
    "containerEnv": {
        "ROS_LOCALHOST_ONLY": "1",
        "ROS_DOMAIN_ID": "42"
    },
    "runArgs": [
        "--net=host",
        "--pid=host",
        "--ipc=host",
        "--gpus", "all",
        "-e", "DISPLAY=${env:DISPLAY}"
    ],
    "mounts": [
       "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
       "type=bind,source=/dev/bus/usb,target=/dev/bus/usb",
       "type=bind,source=/etc/udev/rules.d,target=/etc/udev/rules.d"
    ],
    "postCreateCommand": "sudo rosdep update && sudo chown -R $(whoami) /home/todd"
}